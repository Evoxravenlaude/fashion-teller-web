# Production settings: set these in your host's dashboard (or export them before starting the server).
# Only DJANGO_SECRET_KEY, ALLOWED_HOSTS and CORS_ORIGINS are required to go live.
# Local development needs none of them: `python manage.py runserver` turns debug on by itself.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
ALLOWED_HOSTS=api.fashionteller.com
# The site's origin(s), comma separated. The browser will only be allowed to call the API from these.
CORS_ORIGINS=https://fashionteller.com,https://www.fashionteller.com
# Postgres in production, e.g. postgres://user:pass@host:5432/fashionteller. Empty = SQLite file next to manage.py.
DATABASE_URL=
# Paystack. Empty = test mode: the built-in test checkout (test cards and "bank transfer") completes payments.
# Set the secret key to take real payments: every payment is then verified with Paystack before it is recorded.
PAYSTACK_SECRET_KEY=
# 1 = allow the built-in test checkout while no Paystack key is set (it records payments without moving money).
# Leave 0 on a live site: checkout then refuses until Paystack is connected.
ALLOW_TEST_PAYMENTS=0
# 1 = sample tailors and designers quote, deliver and reply on their own so the product can be tried end to end.
# Keep 0 on a live site (they are only created by `manage.py seed --demo`).
SAMPLE_MODE=0
# Pace of that simulation, in seconds.
SAMPLE_QUOTE_DELAY=2,9
SAMPLE_PHASE_SECONDS=30
DEPOSIT_PERCENT=50

# ── Email ──
# Where links in emails point: the site's address.
SITE_URL=https://fashionteller.com
# Any SMTP provider works. Resend: EMAIL_HOST=smtp.resend.com, EMAIL_HOST_USER=resend, EMAIL_HOST_PASSWORD=<API key>.
# Postmark: smtp.postmarkapp.com, user and password both the server token. Amazon SES: email-smtp.<region>.amazonaws.com.
# Verify your sending domain with the provider first (SPF and DKIM records), or mail lands in spam.
# Leave EMAIL_HOST empty and no email is sent: password reset and address confirmation will not work.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Fashion Teller <hello@fashionteller.com>

# ── Payouts ──
# What Fashion Teller keeps from each payment when it is released to a tailor or designer.
PLATFORM_FEE_PERCENT=10
# With a Paystack key, payouts are sent automatically with Paystack Transfers. Set 0 to pay by hand instead
# (Admin → Payouts lists what is owed and to which account; you mark each one as sent).
PAYSTACK_TRANSFERS=1
# In the Paystack dashboard: add  https://<your-api-host>/api/v1/webhooks/paystack/  as the webhook URL,
# switch off "Confirm transfers before sending" (OTP), and keep enough balance to cover payouts.

# ── Photoreal try-on (optional) ──
# An AI service redraws a customer's photo with the garment on. Each picture is charged by the provider.
FASHN_API_KEY=
AI_TRYON_MODEL=tryon-v1.6
AI_TRYON_DAILY_LIMIT=10
